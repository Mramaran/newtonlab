// Cloudflare Workers config. Build with `npm run build`, deploy with `npx wrangler deploy`.
// Add GEMINI_API_KEY as a secret in the Worker's Settings → Variables and Secrets (never in this file).
{
  "name": "newtonlab",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // Keep variables set in the dashboard; without this, every deploy deletes plain-text ones.
  "keep_vars": true,
  // Run next to Google's US region. Otherwise requests run in whichever data centre is nearest the visitor,
  // and Gemini rejects some of those with "User location is not supported".
  "placement": { "region": "gcp:us-central1" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Send API calls to the Worker before the asset/SPA fallback can answer them.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
