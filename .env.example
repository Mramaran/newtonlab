# Copy to .env.local and fill in. Never commit real keys.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
# Optional, defaults to gemini-3.5-flash-lite
GEMINI_MODEL=
# Optional, used when the main model is rate-limited; defaults to gemini-flash-latest
GEMINI_FALLBACK_MODEL=
